#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp RET
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp RSHFT  &none
                &kp LCTRL &kp LGUI &kp LALT &none &kp SPACE &mo 1 &kp RALT &tog 1
            >;
        };

        layer_1 {
            bindings = <
                &kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
                &trans   &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans   &trans &trans &trans &trans &trans &trans &trans &trans &kp DOT &trans
                &trans   &trans &trans &trans &none  &trans &trans &trans
            >;
        };
    };
};